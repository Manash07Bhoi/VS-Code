# CodeSense AI — Backend environment variables
# Copy to .env and fill in real values. NEVER commit real secrets.
# Variable names and explanations only — no real values here.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
TRUST_PROXY=false

# MongoDB connection URI (separate per environment)
MONGODB_URI=mongodb://127.0.0.1:27017/codesense_ai_dev

# Server-managed session secret (long random string)
SESSION_SECRET=replace-with-a-long-random-secret

# Note: CSRF protection uses a random token bound to each session
# (see src/middleware/csrf.js). No separate CSRF secret is needed.

# Gemini AI provider (primary). Key is backend-only.
# Optional: backend starts without a key and returns an honest
# provider-unavailable state for review requests.
GEMINI_API_KEY=
# Validated against the live API on 2026-11-17 (docs/ai/GEMINI_CONFIGURATION.md).
# The 2.5 flash family now returns 404 for new keys, and the 1.5 names no longer
# exist at all, so do not copy either from old examples.
GEMINI_MODEL=gemini-3.1-flash-lite

# Frontend origin for CORS (no trailing slash)
FRONTEND_ORIGIN=http://localhost:3000

# Secure cookies in production (required when SameSite=None)
SECURE_COOKIES=false

# Cookie SameSite policy: 'lax' for same-site deployment, 'none' for
# cross-site (separate frontend/backend domains). 'none' requires Secure cookies.
COOKIE_SAMESITE=lax

# Cookie domain (empty for same-host; set to your backend domain for cross-site)
COOKIE_DOMAIN=

# Session cookie max age (ms)
SESSION_MAX_AGE_MS=604800000

# Review source size limit (bytes)
REVIEW_SOURCE_SIZE_LIMIT_BYTES=65536

# Gemini timeout (ms), retries, max output chars
GEMINI_TIMEOUT_MS=60000
GEMINI_MAX_RETRIES=2
GEMINI_MAX_OUTPUT_CHARS=32768

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_AUTH=10
# Per-IP cap across ALL auth attempts (bounds credential stuffing)
RATE_LIMIT_MAX_AUTH_IP=60
RATE_LIMIT_MAX_REVIEW=30
RATE_LIMIT_MAX_GENERAL=100

LOG_LEVEL=info
