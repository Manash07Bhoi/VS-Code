# CodeSense AI — .gitignore
# Never commit secrets, dependencies, runtime artifacts, or caches.

# Environment files (template only — .env.example is committed)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/
*.tgz
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime logs
*.log
mongod.log
mongodata/
backend/mongodata/

# OS
.DS_Store
Thumbs.db
.envrc

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Test/coverage artifacts
coverage/
.nyc_output/
backend/tests/reports/
tests/reports/

# Playwright transient outputs (traces, retry results). Evidence screenshots
# and the HTML report under tests/artifacts/ ARE committed deliberately.
tests/artifacts/test-results/
tests/artifacts/.last-run-*

# Build/output
dist/
build/
out/

# Temporary/debug artifacts
diag*.js
debug-*.log

# Secret/credential files
*_token.txt
*_secret*
*.pem
*.key

# MongoDB memory server cache (if used)
.cache/mongodb-memory-server/

# Netlify local state
.netlify/
